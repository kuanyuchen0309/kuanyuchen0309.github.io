{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xudc-editor-oauth",
  "main": "index.js",
  "compatibility_date": "2026-10-01",

  "observability": {
    "enabled": true
  },

  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "在这里填 wrangler kv namespace create SESSIONS 给出的 id"
    }
  ],

  "vars": {
    "GITHUB_REPO": "kuanyuchen0309/kuanyuchen0309.github.io",
    "GITHUB_BRANCH": "main",
    "GITHUB_API_VERSION": "2022-11-28",
    "GITHUB_SCOPE": "repo",
    "ADMIN_URL": "https://kuanyuchen0309.github.io/admin/",
    "ALLOWED_ORIGINS": "https://kuanyuchen0309.github.io,https://xudc.org",
    "COOKIE_SAMESITE": "None",
    "SESSION_TTL_SECONDS": "604800"
  }

  // 下面这几个【不要】写在这里，要用 wrangler secret put 设置成加密变量：
  //   GITHUB_CLIENT_ID         GitHub OAuth App 的 Client ID
  //                             （它本身不算机密，但和 secret 放一起管理更省事）
  //   GITHUB_CLIENT_SECRET     ⚠️ 机密。绝不能出现在任何前端文件里
  //   STATE_SECRET             随便一串长随机字符，用来给 OAuth 的 state 签名
  //
  //   wrangler secret put GITHUB_CLIENT_ID
  //   wrangler secret put GITHUB_CLIENT_SECRET
  //   wrangler secret put STATE_SECRET
}
